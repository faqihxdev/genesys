{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genesys-simulations",
  "account_id": "679db391b52ecfbc45ce4af5a4c11256",
  "main": "workers/simulations.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "genesys",
      "database_id": "533d7b09-c766-497c-84fe-93472e1126e7",
    },
  ],
  "queues": {
    "producers": [{ "binding": "SIMULATION_QUEUE", "queue": "genesys-simulations" }],
    "consumers": [
      {
        "queue": "genesys-simulations",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 2,
      },
    ],
  },
  "observability": { "enabled": true },
}
